# ============================================================
#  .env.example -- Template for environment variables
#  Copy this to .env and fill in real values.
#  This file IS safe to commit to Git.
# ============================================================

# NVIDIA API Key (get yours at https://integrate.api.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key-here

# AI Model name -- verified working NVIDIA NIM models:
#   google/gemma-3-31b-it           (current project model)
#   meta/llama-3.1-8b-instruct      (fast, lightweight)
#   meta/llama-3.3-70b-instruct     (smarter, slower)
#   mistralai/mistral-7b-instruct-v0.3
NVIDIA_MODEL=google/gemma-3-31b-it

# NVIDIA Base URL
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Flask settings
FLASK_PORT=5000
FLASK_DEBUG=true

# SQLite database file (relative to backend/ directory)
# The file will be created automatically on first run.
DB_PATH=sensor_data.db

# ESP32-CAM IP address on your local network.
# Flash hardware/esp32_cam/esp32_cam.ino and check the Serial Monitor for the IP.
# Update this value whenever the camera's DHCP lease changes.
CAMERA_IP=10.5.135.90
