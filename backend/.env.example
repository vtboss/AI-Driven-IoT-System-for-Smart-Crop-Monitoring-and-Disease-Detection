# ============================================================
#  .env.example — Template for environment variables
#  Copy this to .env and fill in real values.
#  This file IS safe to commit to Git.
# ============================================================

# NVIDIA API Key (get yours at https://integrate.api.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key-here

# AI Model name — verified working NVIDIA NIM models:
#   meta/llama-3.1-8b-instruct      (fast, recommended)
#   meta/llama-3.3-70b-instruct     (smarter, slower)
#   mistralai/mistral-7b-instruct-v0.3
#   google/gemma-3-12b-it
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# NVIDIA Base URL
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Flask settings
FLASK_PORT=5000
FLASK_DEBUG=true
