# ============================================================
#  .gitignore — AI-Driven IoT Crop Monitoring System
# ============================================================

# ── Environment & Secrets ───────────────────────────────────
.env
*.env
!.env.example        # Allow the example template

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# ── Virtual Environments ────────────────────────────────────
venv/
env/
.venv/
.env/
ENV/
env.bak/
venv.bak/

# ── Package & Build ─────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
pip-wheel-metadata/
.eggs/

# ── IDE / Editor ────────────────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ────────────────────────────────────────────────────
*.log
logs/
flask_session/

# ── Testing ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── OS Files ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Deployment specific ─────────────────────────────────────
*.pid
*.sock
gunicorn_config.py.bak
